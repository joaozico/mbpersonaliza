# ==============================================================================
# MB PERSONALIZA — VARIÁVEIS DE AMBIENTE (EXEMPLO SEM SEGREDOS)
# Copie para .env na Hostinger VPS e preencha com suas credenciais reais.
# ==============================================================================

# PostgreSQL (Docker Compose / Hostinger VPS)
DATABASE_URL=
POSTGRES_DB=mb_personaliza
POSTGRES_USER=mb_app_user
POSTGRES_PASSWORD=
SQL_HOST=postgres
SQL_PORT=5432
SQL_DB_NAME=mb_personaliza
SQL_USER=mb_app_user
SQL_PASSWORD=
SQL_SSL=false
SQL_SSL_REJECT_UNAUTHORIZED=false
SQL_POOL_MAX=15
SSL_MODE=

# Segurança e Administrador Master
SESSION_SECRET=
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=

# Backups Automáticos e Retenção
BACKUP_AUTO_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# Integrações Externas (Pagamentos / Stricker / Firebase)
MERCADOPAGO_ACCESS_KEY=
MERCADOPAGO_PUBLIC_KEY=
PAGBANK_TOKEN=
STRICKER_ACCESS_KEY=
STRICKER_API_URL=https://ws.spotgifts.com.br/api/v1SSL/
STRICKER_AUTO_SYNC=true
STRICKER_ENVIRONMENT=homologacao
STRICKER_SYNC_INTERVAL_HOURS=12
FIREBASE_API_KEY=
GEMINI_API_KEY=