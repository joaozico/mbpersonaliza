# ==============================================================================
# MB PERSONALIZA - CONFIGURAÇÃO DE AMBIENTE (ENV TEMPLATE)
# ==============================================================================

# SERVIDOR & APLICAÇÃO
PORT="3000"
NODE_ENV="production"
APP_URL="https://www.mbpersonaliza.com.br"

# BANCO DE DADOS POSTGRESQL EXTERNO E INDEPENDENTE (REQUISITO 11)
# Opção A: String de conexão completa (preferencial para serviços gerenciados como Supabase, Neon, RDS, ElephantSQL)
DATABASE_URL="postgresql://mb_user:SUA_SENHA_SEGURA@seu-postgresql-externo.com:5432/mb_personaliza?sslmode=require"

# Opção B: Variáveis individuais (alternativa para servidores dedicados / VPS)
SQL_HOST="seu-postgresql-externo.com"
SQL_PORT="5432"
SQL_USER="mb_user"
SQL_PASSWORD="SUA_SENHA_SEGURA"
SQL_DB_NAME="mb_personaliza"
SQL_SSL="true"
SSL_MODE="require"

# INTEGRAÇÃO STRICKER BRASIL / SPOT WEBSERVICE V1.0
STRICKER_ACCESS_KEY="VkKF-SUA-CHAVE-STRICKER"
STRICKER_ENVIRONMENT="production"
STRICKER_AUTO_SYNC="true"
STRICKER_SYNC_INTERVAL_HOURS="4"

# GATEWAYS DE PAGAMENTO
MERCADOPAGO_ACCESS_KEY="APP_USR-seu-access-token-mercadopago"
MERCADOPAGO_PUBLIC_KEY="APP_USR-sua-chave-publica-mercadopago"
PAGBANK_TOKEN="seu-token-de-producao-pagbank"

# ROTINAS DE BACKUP EXTERNO E RETENÇÃO
BACKUP_AUTO_ENABLED="true"
BACKUP_INTERVAL_HOURS="24"
BACKUP_RETENTION_DAYS="30"

# IA GEMINI (Catálogo inteligente e descrições)
GEMINI_API_KEY=""
